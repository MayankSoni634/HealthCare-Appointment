# Database Connection
DATABASE_URL="file:./dev.db"

# Authentication Secret
JWT_SECRET="super-secret-healthcare-key-change-in-production"

# LLM Integration (OpenAI API key)
# If unconfigured or invalid, system automatically uses pre-configured clinical fallbacks
OPENAI_API_KEY=""

# Email Notifications (Nodemailer / SMTP)
# If unconfigured, email notifications fallback to mock console logging
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="noreply@healthcare-clinic.com"

# Google Calendar Integration (OAuth 2.0)
# If unconfigured, calendar sync logs mock updates gracefully
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
